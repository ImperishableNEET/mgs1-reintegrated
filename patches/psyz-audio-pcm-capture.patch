 static PsyzAudioStats audio_stats;
 static Uint64 last_refill_ns;
 
+/* Developer-only pre-SDL output diagnostic; disabled unless explicitly set. */
+#define PCM_CAPTURE_LIMIT (64u * 1024u * 1024u)
+static FILE* pcm_capture;
+static size_t pcm_capture_bytes;
+
+static void ClosePcmCapture(void) {
+    if (!pcm_capture) return;
+    if (fclose(pcm_capture) != 0)
+        WARNF("audio PCM capture could not finish writing");
+    pcm_capture = NULL;
+    INFOF("audio PCM capture closed: %zu bytes, %zu stereo frames",
+          pcm_capture_bytes, pcm_capture_bytes / 4);
+}
+
+static void OpenPcmCapture(void) {
+    const char* path = getenv("PSYZ_AUDIO_CAPTURE_PATH");
+    pcm_capture_bytes = 0;
+    if (!path || !*path) return;
+    pcm_capture = fopen(path, "wbx");
+    if (!pcm_capture) {
+        WARNF("cannot exclusively create audio PCM capture: %s", path);
+        return;
+    }
+    INFOF("audio PCM capture: %s; raw s16le, stereo, %d Hz; pre-SDL; limit %u bytes",
+          path, PSYZ_SPU_SAMPLE_RATE, PCM_CAPTURE_LIMIT);
+}
+
+static void CapturePcmSamples(const short* samples, int frames) {
+    if (!pcm_capture || frames <= 0) return;
+    unsigned char bytes[BUFFER_FRAMES * 4];
+    while (frames > 0 && pcm_capture) {
+        size_t count = (size_t)frames;
+        if (count > BUFFER_FRAMES) count = BUFFER_FRAMES;
+        size_t remaining = (PCM_CAPTURE_LIMIT - pcm_capture_bytes) / 4;
+        if (count > remaining) count = remaining;
+        for (size_t i = 0; i < count * 2; ++i) {
+            unsigned short value = (unsigned short)samples[i];
+            bytes[i * 2] = (unsigned char)value;
+            bytes[i * 2 + 1] = (unsigned char)(value >> 8);
+        }
+        size_t written = fwrite(bytes, 1, count * 4, pcm_capture);
+        pcm_capture_bytes += written;
+        if (written != count * 4) {
+            WARNF("audio PCM capture write failed; capture disabled");
+            ClosePcmCapture();
+            return;
+        }
+        samples += count * 2;
+        frames -= (int)count;
+        if (pcm_capture_bytes == PCM_CAPTURE_LIMIT) {
+            INFOF("audio PCM capture reached its byte limit");
+            ClosePcmCapture();
+        }
+    }
+}
