+#ifdef MGS_NATIVE
+/* Pointer-bearing tags retain full host addresses. Scalar values still use the
+ * original int parser; this does not widen its public numeric/argument ABI. */
+char *GCL_GetPointerValue(char *top, int *type_p, intptr_t *value_p)
+{
+    unsigned char *p = (unsigned char *)top + 1;
+    int type = (unsigned char)*top;
+    switch (type)
+    {
+    case GCL_STRING:
+        *value_p = (intptr_t)(p + 1);
+        p += *p + 1;
+        break;
+    case GCL_ARG:
+        *value_p = (intptr_t)(p + 2);
+        p += GCL_GetShort((char *)p);
+        break;
+    case GCL_OPTION:
+        type |= *p << 16;
+        *value_p = (intptr_t)(p + 2);
+        p += p[1] + 1;
+        break;
+    default:
+    {
+        int scalar = 0;
+        char *next = GCL_GetNextValue(top, type_p, &scalar);
+        *value_p = scalar;
+        return next;
+    }
+    }
+    *type_p = type;
+    next_str_ptr = (char *)p;
+    return (char *)p;
+}
