 // modified DG_WriteObjVerticesIndirect
+#ifdef MGS_NATIVE
+unsigned int s12c_800D5CDC(unsigned int indices, POLY_GT4 *packs,
+                          POLY_GT4 *parent_packs, SVECTOR *vertices)
+{
+    static const unsigned char shifts[4] = {0, 8, 24, 16};
+    short *xy[4] = {&packs->x0, &packs->x1, &packs->x2, &packs->x3};
+    unsigned flags = *(unsigned short *)(SCRPAD_ADDR + 0x1FE);
+    /* Packed fog depth includes clip bits. Keep the original signed, wrapping
+     * accumulation/division (-fwrapv), including nonpositive bit patterns. */
+    int total = 0, count = 0;
+    if (!parent_packs) return 0;
+    for (int i = 0; i < 4; ++i) {
+        unsigned vertex = (indices >> shifts[i]) & 0xFF;
+        const void *source;
+        unsigned value;
+        if (vertex & 0x80) {
+            int offset = vertices[vertex & 0x7F].pad;
+            source = (char *)parent_packs + offset;
+            if (flags & 4) {
+                /* Fog shading consumes the original parent color pointer. */
+                unsigned color = (unsigned)((const char *)source - sizeof(unsigned));
+                memcpy((char *)xy[i] - sizeof(unsigned), &color, sizeof(color));
+            }
+        } else {
+            int depth;
+            source = (char *)getScratchAddr(0) + vertex * sizeof(unsigned);
+            memcpy(&depth, (const char *)source + 0x200, sizeof(depth));
+            total += depth;
+            ++count;
+        }
+        memcpy(&value, source, sizeof(value));
+        memcpy(xy[i], &value, sizeof(value));
+        MgsTextureCorrectionCopy(xy[i], source);
+    }
+    return count ? total / count : 0;
+}
