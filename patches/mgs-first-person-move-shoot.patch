--- a/source/include/linkvar.h
+++ b/source/include/linkvar.h
@@ -141,6 +141,25 @@
 #define GM_LastSaveSeconds      linkvarbuf[ 94 ]
 #define GM_FirstPerson          linkvarbuf[ 95 ]
 
+#ifdef MGS_NATIVE
+#include <stdlib.h>
+/* Integral's move-and-fire gates read this value. The optional launcher
+ * override stays outside linkvarbuf, so loading and saving keep their
+ * original game state, including the player's difficulty and unlocks. */
+static inline int MgsFirstPersonMoveShootEnabled(void)
+{
+    static int enabled = -1;
+    if (enabled >= 0)
+        return enabled;
+    const char *value = getenv("REI_FIRST_PERSON_MOVE_SHOOT");
+    enabled = value && value[0] == '1' && value[1] == '\0';
+    return enabled;
+}
+#define GM_FirstPersonActive (GM_FirstPerson ? GM_FirstPerson : (MgsFirstPersonMoveShootEnabled() && !(GM_GameStatus & STATE_PADDEMO)))
+#else
+#define GM_FirstPersonActive GM_FirstPerson
+#endif
+
 /*---------------------------------------------------------------------------*/
 
