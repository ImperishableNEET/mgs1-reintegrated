+int Psyz_PadsDeviceInfo(unsigned kind, unsigned instance, PsyzInputDeviceInfo *info) {
+    if (!info) return 0;
+    memset(info, 0, sizeof(*info));
+    info->kind = kind; info->instance = instance;
+    if (kind == 1) {
+        info->connected = PsyzMantisKeyboardIdentity(instance, info->path, sizeof(info->path),
+            info->usb_socket, sizeof(info->usb_socket));
+        return info->connected;
+    }
+    if (kind != 2) return 0;
+    for (int i = 0; i < LEN(gamepads); ++i) {
+        if (!gamepads[i].dev || gamepads[i].id != instance) continue;
+        info->connected = 1; info->family = gamepad_slots[i].family;
+        SDL_strlcpy(info->serial, gamepad_slots[i].serial, sizeof(info->serial));
+        SDL_strlcpy(info->usb_socket, gamepad_slots[i].usb_socket, sizeof(info->usb_socket));
+        const char *path = SDL_GetGamepadPath(gamepads[i].dev);
+        if (path) SDL_strlcpy(info->path, path, sizeof(info->path));
+        return 1;
+    }
+    return 0;
+}
+
+int Psyz_PadsDeviceConnected(const PsyzInputDeviceInfo *baseline) {
+    if (!baseline || !baseline->kind) return 0;
+    PsyzInputDeviceInfo current;
+    if (Psyz_PadsDeviceInfo(baseline->kind, baseline->instance, &current) &&
+        (!baseline->serial[0] || !current.serial[0] || !strcmp(baseline->serial, current.serial)) &&
+        (!baseline->path[0] || !current.path[0] || !strcmp(baseline->path, current.path))) return 1;
+    int count = baseline->kind == 1 ? SDL_arraysize(psyz_mantis_keyboards) : LEN(gamepads);
+    for (int i = 0; i < count; ++i) {
+        unsigned id = baseline->kind == 1 ? psyz_mantis_keyboards[i].id : gamepads[i].id;
+        if (!Psyz_PadsDeviceInfo(baseline->kind, id, &current)) continue;
+        if (baseline->serial[0] && current.serial[0] && !strcmp(baseline->serial, current.serial)) return 1;
+        if (baseline->path[0] && current.path[0] && !strcmp(baseline->path, current.path)) return 1;
+    }
+    return 0;
+}
