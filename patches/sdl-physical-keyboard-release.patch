+static void WIN_SendRawKeyboardKey(Uint64 timestamp, SDL_KeyboardID keyboardID, int rawcode, SDL_Scancode code, bool down)
+{
+    /* SDL's aggregate state can already be up when a second physical keyboard
+     * releases the same key. Preserve that device's release for per-keyboard
+     * consumers without changing the aggregate state or modifier policy. */
+    bool physical_release = keyboardID != 0 && !down &&
+        code > SDL_SCANCODE_UNKNOWN && code < SDL_SCANCODE_COUNT &&
+        !SDL_GetKeyboardState(NULL)[code];
+    SDL_SendKeyboardKey(timestamp, keyboardID, rawcode, code, down);
+    if (physical_release && SDL_EventEnabled(SDL_EVENT_KEY_UP)) {
+        SDL_Event event;
+        SDL_zero(event);
+        SDL_Window *focus = SDL_GetKeyboardFocus();
+        event.type = SDL_EVENT_KEY_UP;
+        event.key.timestamp = timestamp;
+        event.key.windowID = focus ? focus->id : 0;
+        event.key.which = keyboardID;
+        event.key.scancode = code;
+        event.key.mod = SDL_GetModState();
+        event.key.key = SDL_GetKeyFromScancode(code, event.key.mod, true);
+        event.key.raw = (Uint16)rawcode;
+        SDL_PushEvent(&event);
+    }
+}
