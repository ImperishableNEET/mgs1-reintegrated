@@ -0,0 +1,102 @@
+/* Read-only Windows USB topology evidence. No instance ID or GUID is used
+ * as a socket identity. Unsupported backends deliberately return no evidence. */
+#ifndef PSYZ_GAMEPAD_USB_LOCATION_H
+#define PSYZ_GAMEPAD_USB_LOCATION_H
+#if defined(_WIN32)
+#ifndef WIN32_LEAN_AND_MEAN
+#define WIN32_LEAN_AND_MEAN
+#endif
+#include <windows.h>
+#include <cfgmgr32.h>
+#include <wchar.h>
+
+static int PsyzGamepadUsbLocation(const char *path, char *result, size_t capacity) {
+    typedef CONFIGRET (WINAPI *InterfacePropertyFn)(LPCWSTR, const DEVPROPKEY *, DEVPROPTYPE *, PBYTE, PULONG, ULONG);
+    typedef CONFIGRET (WINAPI *LocateFn)(PDEVINST, DEVINSTID_W, ULONG);
+    typedef CONFIGRET (WINAPI *ParentFn)(PDEVINST, DEVINST, ULONG);
+    typedef CONFIGRET (WINAPI *IdFn)(DEVINST, PWSTR, ULONG, ULONG);
+    typedef CONFIGRET (WINAPI *PropertyFn)(DEVINST, const DEVPROPKEY *, DEVPROPTYPE *, PBYTE, PULONG, ULONG);
+    static const DEVPROPKEY instance_key = {{0x78c34fc8,0x104a,0x4aca,{0x9e,0xa4,0x52,0x4d,0x52,0x99,0x6e,0x57}},256};
+    static const DEVPROPKEY location_key = {{0xa45c254e,0xdf1c,0x4efd,{0x80,0x20,0x67,0xd1,0x46,0xa8,0x50,0xe0}},37};
+    result[0] = 0;
+    if (!path || strncmp(path, "\\\\?\\", 4)) return 0;
+    /* Load only the Windows system library; do not search the working folder. */
+    HMODULE library = LoadLibraryExW(L"cfgmgr32.dll", NULL, LOAD_LIBRARY_SEARCH_SYSTEM32);
+    if (!library) return 0;
+    InterfacePropertyFn interface_property = (InterfacePropertyFn)GetProcAddress(library, "CM_Get_Device_Interface_PropertyW");
+    LocateFn locate = (LocateFn)GetProcAddress(library, "CM_Locate_DevNodeW");
+    ParentFn parent = (ParentFn)GetProcAddress(library, "CM_Get_Parent");
+    IdFn get_id = (IdFn)GetProcAddress(library, "CM_Get_Device_IDW");
+    PropertyFn property = (PropertyFn)GetProcAddress(library, "CM_Get_DevNode_PropertyW");
+    int ok = 0;
+    WCHAR interface_path[1024], id[512], locations[1024];
+    DEVPROPTYPE type;
+    ULONG bytes = sizeof(id);
+    DEVINST node;
+    if (!interface_property || !locate || !parent || !get_id || !property ||
+        !MultiByteToWideChar(CP_UTF8, MB_ERR_INVALID_CHARS, path, -1, interface_path, 1024)) goto done;
+    memset(id, 0, sizeof(id));
+    if (interface_property(interface_path, &instance_key, &type, (PBYTE)id, &bytes, 0) != CR_SUCCESS ||
+        type != DEVPROP_TYPE_STRING || bytes > sizeof(id) || id[511] ||
+        locate(&node, id, CM_LOCATE_DEVNODE_NORMAL) != CR_SUCCESS) goto done;
+    for (int level = 0; level < 16; ++level) {
+        memset(id, 0, sizeof(id));
+        if (get_id(node, id, 512, 0) != CR_SUCCESS) break;
+        /* Never mistake a Bluetooth radio's USB socket for the controller. */
+        if (!_wcsnicmp(id, L"BTH", 3)) break;
+        if (!_wcsnicmp(id, L"USB\\VID_", 8) && !wcsstr(id, L"&MI_")) {
+            bytes = sizeof(locations);
+            memset(locations, 0, sizeof(locations));
+            if (property(node, &location_key, &type, (PBYTE)locations, &bytes, 0) != CR_SUCCESS ||
+                type != DEVPROP_TYPE_STRING_LIST || bytes > sizeof(locations) || bytes < 4 ||
+                locations[1023]) break;
+            /* Windows may supply both PCI and ACPI aliases. Select the unique
+             * PCI/USBROOT path, independent of MULTI_SZ ordering. */
+            const WCHAR *chosen = NULL;
+            size_t limit = bytes / sizeof(WCHAR), offset = 0;
+            while (offset < limit && locations[offset]) {
+                const WCHAR *value = locations + offset;
+                const WCHAR *end = wmemchr(value, 0, limit - offset);
+                if (!end) goto done;
+                if (!wcsncmp(value, L"PCIROOT(", 8) && wcsstr(value, L"#USBROOT(")) {
+                    if (chosen && wcscmp(chosen, value)) goto done;
+                    chosen = value;
+                }
+                offset += (size_t)(end - value) + 1;
+            }
+            if (offset >= limit || !chosen) break;
+            size_t length = wcslen(chosen);
+            if (length >= capacity) break;
+            for (size_t i = 0; i <= length; ++i) {
+                if (chosen[i] > 127) goto done;
+                result[i] = (char)chosen[i];
+            }
+            /* A wired topology must terminate at a physical USB port. */
+            const char *usb = strstr(result, "#USB(");
+            if (!strstr(result, "#USBROOT(") || !usb) goto done;
+            while (usb) {
+                const char *n = usb + 5;
+                if (*n < '0' || *n > '9') goto done;
+                while (*n >= '0' && *n <= '9') ++n;
+                if (*n++ != ')') goto done;
+                if (!*n) { ok = 1; break; }
+                if (strncmp(n, "#USB(", 5)) goto done;
+                usb = n;
+            }
+            break;
+        }
+        DEVINST next;
+        if (parent(&next, node, 0) != CR_SUCCESS) break;
+        node = next;
+    }
+done:
+    FreeLibrary(library);
+    if (!ok) result[0] = 0;
+    return ok;
+}
+#else
+static int PsyzGamepadUsbLocation(const char *path, char *result, size_t capacity) {
+    (void)path; (void)capacity; result[0] = 0; return 0;
+}
+#endif
+#endif
