@@ -0,0 +1,70 @@
+#ifndef PSYZ_GAMEPAD_SLOTS_H
+#define PSYZ_GAMEPAD_SLOTS_H
+#include <string.h>
+
+typedef struct PsyzGamepadSlot {
+    int connected;
+    char serial[128];
+    char usb_socket[512];
+    int family; /* Stable physical family, never a transport GUID or USB port. */
+} PsyzGamepadSlot;
+
+static int PsyzGamepadHasSerial(const char *serial) {
+    return serial && serial[0] && strlen(serial) < 128;
+}
+
+static int PsyzGamepadChooseSlot(const PsyzGamepadSlot *slots, int count,
+                                 const char *serial, int family, const char *usb_socket, int allow_replacement_port2) {
+    int known = allow_replacement_port2 && PsyzGamepadHasSerial(serial);
+    /* Instance IDs change after reconnect; only an available device serial
+     * can restore a remembered identity. Never compare a model GUID. */
+    if (known) {
+        for (int i = 0; i < count; ++i)
+            if (slots[i].connected && !strcmp(slots[i].serial, serial))
+                return -2; /* Duplicate identity may be a virtual alias. */
+        /* Same verified device moved to a different physical USB socket.
+         * Preserve the original slot's socket so moving back restores port 1. */
+        if (count >= 2 && !slots[0].connected && !slots[1].connected &&
+            !strcmp(slots[0].serial, serial) && slots[0].usb_socket[0] &&
+            usb_socket && usb_socket[0])
+            return strcmp(slots[0].usb_socket, usb_socket) ? 1 : 0;
+        for (int i = 0; i < count; ++i)
+            if (!slots[i].connected && slots[i].serial[0] &&
+                !strcmp(slots[i].serial, serial)) return i;
+        /* A verified replacement for the original controller occupies port 2.
+         * Missing serials remain conservative and use the first free slot. */
+        if (allow_replacement_port2 && count >= 2 && !slots[0].connected && !slots[1].connected &&
+            slots[0].serial[0] && strcmp(slots[0].serial, serial)) return 1;
+    }
+    /* Missing serials are common with XInput. A different known physical
+     * family is evidence of replacement; a same-family reconnect is not.
+     * Only restore model identity when no serial can contradict it. */
+    if (allow_replacement_port2 && family && count >= 2 &&
+        !slots[0].connected && !slots[1].connected && slots[0].family) {
+        if (family == slots[0].family) return 0;
+        return 1;
+    }
+    for (int i = 0; i < count; ++i)
+        if (!slots[i].connected) return i;
+    return -1;
+}
+
+/* Outside the second-controller scene, keep a lone replacement usable.
+ * This maps gamepad devices only; keyboard remains on logical host zero. */
+static int PsyzGamepadHostSlot(const PsyzGamepadSlot *slots, int count,
+                               int port, int identity_ports) {
+    if (port >= 0 && port < 2 && count >= 2 && !identity_ports &&
+        !slots[0].connected && slots[1].connected) return port ^ 1;
+    return port;
+}
+
+static void PsyzGamepadRememberSlot(PsyzGamepadSlot *slot, const char *serial, int family, const char *usb_socket) {
+    slot->connected = 1;
+    slot->family = family;
+    slot->usb_socket[0] = 0;
+    if (usb_socket && strlen(usb_socket) < sizeof(slot->usb_socket))
+        memcpy(slot->usb_socket, usb_socket, strlen(usb_socket) + 1);
+    slot->serial[0] = 0;
+    if (PsyzGamepadHasSerial(serial)) memcpy(slot->serial, serial, strlen(serial) + 1);
+}
+#endif
