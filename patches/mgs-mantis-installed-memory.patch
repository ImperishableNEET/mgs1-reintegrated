+/* Feed the original memory-card title matcher only the four verified Integral
+ * references. The launcher records this bitmask for deterministic replay. */
+static void NativeInstalledProfile( MEMCARD *card, unsigned int mask )
+{
+    static const struct {
+        unsigned int bit;
+        const char *name;
+    } titles[] = {
+        { MGS_MANTIS_SUIKODEN,      "BISLPS-00097" },
+        { MGS_MANTIS_AZURE_DREAMS,   "BISLPM-86047" },
+        { MGS_MANTIS_CASTLEVANIA,    "BISLPM-86023" },
+        { MGS_MANTIS_VANDAL_HEARTS,  "BISLPM-86007" }
+    };
+    int i;
+
+    memset( card, 0, sizeof(*card) );
+    for ( i = 0; i < COUNTOF( titles ); i++ )
+    {
+        if ( !(mask & titles[i].bit) ) continue;
+        snprintf( card->files[card->file_count].name,
+                  sizeof(card->files[card->file_count].name), "%s", titles[i].name );
+        card->files[card->file_count].size = MEMCARD_BLOCK_SIZE;
+        card->file_count++;
+    }
+    printf( "[mantis] Installed-game memory profile mask=0x%02x\n", mask );
+}
