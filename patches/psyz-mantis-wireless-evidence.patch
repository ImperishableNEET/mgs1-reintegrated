     UpdatePlatformTouchControls();
 }
 
+/* Only known direct USB controller products qualify for socket evidence.
+ * SDL may label a USB wireless receiver WIRED, so connection state alone is
+ * insufficient. Unknown products keep device switching and manual fallbacks. */
+static int MantisDirectUsbGamepad(SDL_Gamepad *dev) {
+    if (SDL_GetGamepadConnectionState(dev) != SDL_JOYSTICK_CONNECTION_WIRED) return 0;
+    unsigned vendor = SDL_GetGamepadVendor(dev), product = SDL_GetGamepadProduct(dev);
+    if (vendor == 0x054c) {
+        return product == 0x0268 || product == 0x05c4 || product == 0x09cc ||
+               product == 0x0ce6 || product == 0x0df2;
+    }
+    if (vendor == 0x045e) {
+        return product == 0x028e || product == 0x02d1 || product == 0x02dd ||
+               product == 0x02e3 || product == 0x0b00 || product == 0x02ea ||
+               product == 0x0b12 || product == 0x0b0a;
+    }
+    return 0;
+}
+
+/* Official PS4/PS5 HIDAPI serials come from the controller feature report /
+ * Bluetooth address. Generic HID serials may instead identify a receiver. */
+static int MantisControllerSerial(SDL_Gamepad *dev) {
+    if (MantisDirectUsbGamepad(dev)) return 1;
+    if (SDL_GetGamepadVendor(dev) != 0x054c) return 0;
+    unsigned product = SDL_GetGamepadProduct(dev);
+    return product == 0x05c4 || product == 0x09cc || product == 0x0ce6 || product == 0x0df2;
+}
