diff --git a/source/onoda/abst/mission_log_fast.h b/source/onoda/abst/mission_log_fast.h
new file mode 100644
--- /dev/null
+++ b/source/onoda/abst/mission_log_fast.h
@@ -0,0 +1,27 @@
+#ifndef REI_MISSION_LOG_FAST_H
+#define REI_MISSION_LOG_FAST_H
+
+#include <stdlib.h>
+
+/* Optional launcher presentation setting. Direct engine launches keep PS1 timing. */
+static void ReiMissionLogAdvance(int *frame, int final_frame)
+{
+    static int enabled = -1;
+
+    if (enabled < 0)
+    {
+        const char *value = getenv("REI_MISSION_LOG_FAST");
+        enabled = value && value[0] == '1' && value[1] == '\0';
+    }
+
+    if (enabled && *frame > 0 && *frame < final_frame)
+    {
+        *frame += 3;
+        if (*frame > final_frame)
+        {
+            *frame = final_frame;
+        }
+    }
+}
+
+#endif
